# .env (secrets removed)
# This file previously contained sensitive secrets which have been removed from the repository.
# DO NOT commit secrets here. Use environment variables, GitHub Secrets, or a secrets manager.
# See .env.example for the variables your app expects.

APP_ENV=prod
APP_DEBUG=false
APP_DEMO=false
APP_MAINTENANCE=false

# Services variables
MAILER_DSN=

# Database connection setting (DO NOT store plaintext credentials here)
DATABASE_URL=

# Modules and storage
UPLOAD_DIR=upload
IMAGES_UPLOAD_DIR=upload/images
FILES_UPLOAD_DIR=upload/files
VIDEOS_UPLOAD_DIR=upload/videos
MINIATURES_UPLOAD_DIR=upload/miniatures
PUBLIC_ROOT_DIR=public

# Security
APP_IPS_ACCESS_RESTRICTION="[]"

# Monitoring
APP_EMERGENCY_EMAILS_RECEIVER_EMAIL="your@email.com"

# Symfony app secret (REGENERATE and set as an environment variable)
APP_SECRET=

# Notifier Proxy Logger defaults
APP_DEFAULT_NPL_RECEIVER_EMAILS=["your@email.com"]
