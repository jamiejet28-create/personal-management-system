# Example .env file for personal-management-system
# Copy this to a real .env locally for development OR set the variables in your deployment environment.
# NEVER commit real secrets to the repository.

APP_ENV=prod
APP_DEBUG=false
APP_DEMO=false
APP_MAINTENANCE=false

# Services variables
# Example: smtp://username:password@smtp.example.com:587
MAILER_DSN=smtp://username:password@smtp.example.com:587?verify_peer=1

# Database connection setting
# Example: mysql://dbuser:strongpassword@db-host:3306/dbname
DATABASE_URL=mysql://dbuser:strongpassword@db-host:3306/pms

# Modules and storage (defaults)
UPLOAD_DIR=upload
IMAGES_UPLOAD_DIR=upload/images
FILES_UPLOAD_DIR=upload/files
VIDEOS_UPLOAD_DIR=upload/videos
MINIATURES_UPLOAD_DIR=upload/miniatures
PUBLIC_ROOT_DIR=public

# Security
# Example: ["127.0.0.1","192.168.10.1"]
APP_IPS_ACCESS_RESTRICTION="[]"

# Monitoring
APP_EMERGENCY_EMAILS_RECEIVER_EMAIL="ops@example.com"

# Symfony app secret (generate one: openssl rand -hex 32)
APP_SECRET=replace_with_generated_secret

# Notifier Proxy Logger defaults
APP_DEFAULT_NPL_RECEIVER_EMAILS=["ops@example.com"]
